# Copy to .env for local dev (python-decouple reads this automatically).
# In production these are set as real environment variables on Railway/Render — never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank locally to use SQLite. Set this to mirror production with a real
# Postgres instance, e.g. postgres://user:password@localhost:5432/attendance_db
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

QR_SESSION_EXPIRY_MINUTES=5
ATTENDANCE_OFFLINE_GRACE_MINUTES=15
FACE_MATCH_COSINE_THRESHOLD=0.75

# Production-only (safe to leave blank locally)
REDIS_URL=
SENTRY_DSN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
